# Medusa backend (backend/). Copy to backend/.env and fill in. Never commit real keys.
# Every variable the backend reads is listed here; web/tests/unit/env-examples.test.ts checks it.

# Database and cache.
DATABASE_URL=
DB_NAME=medusa-v2
REDIS_URL=redis://localhost:6379

# Who may call the Store, Admin and Auth APIs (comma-separated origins).
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Session secrets: long random strings on the server.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Public addresses: the storefront (payment return, links from «Простий кабінет») and this backend
# (WayForPay sends payment results to <BACKEND_PUBLIC_URL>/hooks/wayforpay).
STOREFRONT_URL=http://localhost:3100
BACKEND_PUBLIC_URL=http://localhost:9000

# Shared secret for backend -> storefront calls (fiscal receipts). Same value in web/.env.local.
INTERNAL_API_TOKEN=

# WayForPay: merchant cabinet -> Store settings. Domain = the site's domain registered there.
WFP_MERCHANT=
WFP_SECRET=
WFP_DOMAIN=

# Fonts for measuring customer text on the server (defaults: ../web/public/fonts and uploads/fonts).
FONTS_DIR=
CUSTOM_FONTS_DIR=
# Production files of orders: SVG/DXF for the laser, PNG previews, parameters, customer fonts
# (default: uploads/orders). Back this folder up together with uploads/fonts.
ORDER_FILES_DIR=
# Photos of customer reviews (default: uploads/reviews). Shown on the site only after moderation;
# back this folder up together with uploads/orders.
REVIEW_PHOTOS_DIR=

# Staging copy only (deploy/staging): the storefront's publishable key chosen in advance,
# "pk_" + 64 hex characters (openssl rand -hex 32). The same value goes to the storefront's
# NEXT_PUBLIC_MEDUSA_PK. staging-setup.ts writes it onto the seeded key.
STAGING_PUBLISHABLE_KEY=

# Catalogue import scripts (set on the command line when running them):
#   CATALOG_DIR=<catalog folder with data/products.json> IMPORT_MODE=create|update npx medusa exec ./src/scripts/import-catalog.ts
#   CATALOG_ACTION=publish-imported|draft-imported|reset-imported npx medusa exec ./src/scripts/catalog-status.ts
#   BOT_DIR=<bot folder> npx medusa exec ./src/scripts/create-bot-api-key.ts
# CATALOG_DIR=
# IMPORT_MODE=create
# CATALOG_ACTION=
# BOT_DIR=
SALES_CHANNEL_NAME=Trafaret Line
