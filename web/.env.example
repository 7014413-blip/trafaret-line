# Storefront (web/). Copy to web/.env.local and fill in. Never commit real keys.
# Every variable the storefront reads is listed here; tests/unit/env-examples.test.ts checks it.
# The backend has its own list in backend/.env.template, the Telegram bot in bot/.env.example.

# Medusa (store backend) and the publishable key of the storefront sales channel.
# NEXT_PUBLIC_MEDUSA_URL must be the same at build and at start (product photos are allowed by it).
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PK=
# Optional: address of Medusa inside the server network, for server-side calls (default NEXT_PUBLIC_MEDUSA_URL).
MEDUSA_INTERNAL_URL=

# Public address of the site for canonical links, sitemap and robots (default https://trafaret-line.com.ua).
# A staging copy sets its own address so it does not claim the real domain.
NEXT_PUBLIC_SITE_URL=

# Shared secret for Medusa -> storefront calls (fiscal receipts). Same value in backend/.env.
INTERNAL_API_TOKEN=

# Nova Poshta: personal cabinet -> Settings -> Security -> API key.
NP_API_KEY=
# Optional: sender city reference; without it the city NP_SENDER_CITY is looked up (default Бориспіль).
NP_SENDER_CITY_REF=
NP_SENDER_CITY=Бориспіль
# Only for tests: another address for the Nova Poshta API (end-to-end tests point it at the mock shop).
# NP_API_URL=

# Вчасно.Каса: cabinet -> cash register -> settings -> Token. Fiscal key must be added in «Ключі».
VCHASNO_KASA_TOKEN=
# Tax group of receipt rows; empty = the one in data/knowledge_base/rules_fop.json ("2" = without VAT).
VCHASNO_TAXGRP=
VCHASNO_CASHIER=Trafaret Line
VCHASNO_ATTEMPTS=3

# Google AI Studio (Gemini API) key for the shop assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=800

# Opendatabot API v4 key (requisites for B2B invoices).
OPENDATABOT_API_KEY=

# Seller requisites for B2B invoices (/rakhunok/<order id>): РНОКПП, IBAN, bank, legal address.
# The seller's name and tax status are in data/knowledge_base/rules_fop.json.
SELLER_CODE=
SELLER_IBAN=
SELLER_BANK=
SELLER_ADDRESS=
