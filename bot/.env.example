# Скопіюйте цей файл у .env (у тій самій папці) і впишіть значення.
# Файл .env нікому не надсилайте і не викладайте в чат.

# Токен від @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Ваш Telegram ID (бот покаже його на /start). Кілька ID через кому.
ALLOWED_TELEGRAM_IDS=

# Черга заявок конвеєра. За замовчуванням ..\factory\inbox від папки бота,
# тобто D:\сайт клод\сайт украина\factory\inbox
# INBOX_DIR=

# Адмінка сайту (Medusa) для кнопки «Опублікувати на сайті».
MEDUSA_BACKEND_URL=http://localhost:9000
# Секретний ключ: адмінка Medusa → Settings → Secret API Keys → Create. Без нього кнопка публікації вимкнена.
MEDUSA_ADMIN_API_KEY=

# Як часто перевіряти стан заявок, секунд (за замовчуванням 60)
# STATUS_POLL_SECONDS=60

# Папка зі знімком категорій і матеріалів (data/). За замовчуванням — папка бота.
# CATALOG_DIR=

# Файл стану бота (заявки й повідомлення). За замовчуванням bot-state.json у папці бота.
# BOT_STATE_FILE=

# Найбільший файл від користувача, МБ (за замовчуванням 20)
# MAX_FILE_MB=20
